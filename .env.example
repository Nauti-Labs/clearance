# Clearance by Nauti-Labs
# Copy to .env and fill in values

# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-secret

# Base URL (for approval links and token issuer)
BASE_URL=http://localhost:8000
TOKEN_ISSUER=http://localhost:8000
BRAND_URL=https://nauti-labs.com

# Database path
DB_PATH=clearance.db

# USDC on Base payment config
PAYMENT_WALLET=0xYOUR_BASE_RECEIVE_ADDRESS
PAYMENT_ENS=yourname.base.eth
PAYMENT_CHAIN=base
PAYMENT_CHAIN_ID=8453
USDC_CONTRACT=0xUSDC_CONTRACT_ON_BASE
BASE_RPC_URL=https://mainnet.base.org
MIN_CONFIRMATIONS=12

# Stripe card checkout
# Create a webhook endpoint for: /v1/payments/stripe/webhook
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=https://clearance.nauti-labs.com/?checkout=success
STRIPE_CANCEL_URL=https://clearance.nauti-labs.com/?checkout=cancelled

# Telegram approval notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Support email
ADMIN_EMAIL=consulting@nauti-labs.com
PAYMENT_SUPPORT_EMAIL=consulting@nauti-labs.com

# Harbor Ledger family dashboard
FAMILY_PRODUCT_NAME=Harbor Ledger
FAMILY_HOUSEHOLD_NAME=LeBlanc Family
FAMILY_JUSTIN_PASSCODE=change-me-justin
FAMILY_NICOLE_PASSCODE=change-me-nicole
FAMILY_SYNC_TOKEN=change-me-sync-token
FAMILY_SESSION_HOURS=18
