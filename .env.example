# Clearance by Nauti-Labs
# Copy to .env and fill in values.
# Secret values stay empty here. Do not commit a filled-in .env file.

# Required. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Required. Bot-comm admin login. Traffic board uses this when TRAFFIC_BOARD_PASSWORD is unset.
BOT_COMM_PASSWORD=
TRAFFIC_BOARD_PASSWORD=

# Public origin for approval links and the token issuer.
# Local default is below. Production should be your public https origin.
BASE_URL=http://localhost:8000
TOKEN_ISSUER=http://localhost:8000
# Origin advertised in 402 resource URLs and x402 discovery documents.
# Falls back to BASE_URL. In production every resource URL must be https.
# An http origin that is not localhost is advertised as https.
PUBLIC_BASE_URL=
BRAND_URL=https://nauti-labs.com
# Optional extra browser origins. Brand origin and www are added automatically.
# LOCAL_DEV_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081
# BOT_COMM_CORS_ORIGINS=

# Bind address and port. HOST defaults to 0.0.0.0. PORT defaults to 8000.
HOST=0.0.0.0
PORT=8000

# Database path. On a free host this file is lost on restart.
# A persistent disk requires a paid plan; then use DB_PATH=/var/data/clearance.db.
DB_PATH=clearance.db

# USDC on Base. PAYMENT_WALLET and USDC_CONTRACT are required in production.
# PAYMENT_ENS is optional.
# Example receiving wallet (USDC on Base):
PAYMENT_WALLET=0xaC73A1dC4FEc75b61478Fb34186C6a379EA01CC2
PAYMENT_ENS=
PAYMENT_CHAIN=base
PAYMENT_CHAIN_ID=8453
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_RPC_URL=https://mainnet.base.org
MIN_CONFIRMATIONS=12

# Standard x402 v2 exact payments. Direct Base transfers (X-Payment-Tx / payment_tx)
# still work when these are unset. Without the CDP key pair, a PAYMENT-SIGNATURE
# request returns HTTP 402 instead of settling.
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional second secret for GET /v1/revenue/payments. BOT_COMM_PASSWORD also works.
ADMIN_TOKEN=

# Optional hidden payment probe, for example 0.05. Unset means /agent-income/test-ping is 404
# and the service is omitted from discovery.
# TEST_PRICE_USD=

# Outreach stays off unless you set these to true.
AGENT_INCOME_OPERATOR_ENABLED=false
AGENT_INCOME_PUBLIC_LEAD_DISCOVERY_ENABLED=false
AGENT_INCOME_AUTO_DEAL_LEADS=false

# Stripe card checkout
# Webhook path: /v1/payments/stripe/webhook
# When the success and cancel URLs are unset, they are derived from BASE_URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=

# Scam-check public origin. When unset, defaults to BASE_URL + /scram.
# SCRAM_BASE_URL=
# PUBLIC_SCRAM_URL=
# PUBLIC_PAYMENT_URL=
# IP lookup host for traffic labels. Defaults to http://ip-api.com
# IP_LOOKUP_BASE_URL=http://ip-api.com

# Telegram approval notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Support email. Public contact for this product.
ADMIN_EMAIL=consulting@nauti-labs.com
PAYMENT_SUPPORT_EMAIL=consulting@nauti-labs.com
AMBASSADOR_REQUEST_NOTIFY_EMAIL=consulting@nauti-labs.com

# Signup email notifications
SIGNUP_NOTIFY_EMAIL=consulting@nauti-labs.com
EMAIL_FROM=Clearance <consulting@nauti-labs.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
WELCOME_EMAILS_ENABLED=false

# Optional ip=label pairs, comma-separated. No default identities.
TRAFFIC_KNOWN_USERS=

# Optional JSON array of outreach objects: target, fit, contact, source.
AGENT_OUTREACH_TARGETS=

# Optional private ledger UI. Off unless set to true. Not part of the public product.
LEDGER_TOOLS_ENABLED=false
LEDGER_PRODUCT_NAME=
LEDGER_DISPLAY_NAME=
LEDGER_SYNC_TOKEN=
# JSON array: [{"username":"","display_name":"","passcode":"","role":"operator"}]
LEDGER_USERS_JSON=

# SCRAM / SMS. Delivery is a stub until a provider is wired.
SMS_PROVIDER=local
SMS_FROM_NUMBER=
SCRAM_TEXT_CODE=72726
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_VALIDATE_SIGNATURE=true
SCRAM_FREE_CHECKS=3
SCRAM_FREE_HELP_MESSAGES=5
